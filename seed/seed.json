{
  "$schema": "https://emdashcms.com/seed.schema.json",
  "version": "1",
  "meta": {
    "name": "Pamelina Pereira",
    "description": "Architecture portfolio"
  },
  "settings": {
    "title": "Pamelina Pereira",
    "tagline": "Architecture and interiors. Quiet buildings shaped by light, material and climate.",
    "timezone": "Asia/Kolkata"
  },
  "collections": [
    {
      "slug": "projects",
      "label": "Projects",
      "labelSingular": "Project",
      "description": "Each project shows on the home page. Lower position numbers show first.",
      "admin": {
        "listColumns": [
          "year",
          "position"
        ]
      },
      "sortOrder": 1,
      "urlPattern": "/#{slug}",
      "supports": [
        "drafts",
        "revisions"
      ],
      "fields": [
        {
          "slug": "title",
          "label": "Project name",
          "type": "string",
          "required": true
        },
        {
          "slug": "location",
          "label": "Location (City, Country)",
          "type": "string",
          "required": true
        },
        {
          "slug": "year",
          "label": "Year",
          "type": "string",
          "required": true,
          "validation": {
            "pattern": "^[0-9]{4}$"
          }
        },
        {
          "slug": "type",
          "label": "Type (for example Residential)",
          "type": "string",
          "required": true
        },
        {
          "slug": "area",
          "label": "Area (for example 18,000 m²). Leave empty to hide",
          "type": "string"
        },
        {
          "slug": "project_status",
          "label": "Status (for example Completed). Leave empty to hide",
          "type": "string"
        },
        {
          "slug": "position",
          "label": "Position on the page (1 shows first)",
          "type": "integer",
          "required": true
        },
        {
          "slug": "photos",
          "label": "Photos (the first one is the cover)",
          "type": "repeater",
          "required": true,
          "validation": {
            "minItems": 1,
            "maxItems": 40,
            "subFields": [
              {
                "slug": "image",
                "label": "Photo",
                "type": "image",
                "required": true
              }
            ]
          }
        },
        {
          "slug": "description",
          "label": "Description",
          "type": "portableText"
        }
      ]
    },
    {
      "slug": "profile",
      "label": "About me",
      "labelSingular": "About me",
      "description": "Your name, intro, services, awards and contact details on the left side of the site. There is only one of these, just edit it.",
      "admin": {
        "quickCreate": false
      },
      "sortOrder": 2,
      "routable": false,
      "supports": [
        "revisions"
      ],
      "fields": [
        {
          "slug": "title",
          "label": "Your name",
          "type": "string",
          "required": true
        },
        {
          "slug": "role",
          "label": "Role (for example Architect)",
          "type": "string"
        },
        {
          "slug": "city",
          "label": "City",
          "type": "string"
        },
        {
          "slug": "timezone",
          "label": "Time zone for the clock",
          "type": "select",
          "validation": {
            "options": [
              "Asia/Kolkata",
              "Asia/Dubai",
              "Europe/London",
              "Europe/Lisbon",
              "America/New_York"
            ]
          }
        },
        {
          "slug": "availability",
          "label": "Availability (for example Open for new projects)",
          "type": "string"
        },
        {
          "slug": "intro",
          "label": "Short intro",
          "type": "text"
        },
        {
          "slug": "services",
          "label": "Services",
          "type": "repeater",
          "validation": {
            "subFields": [
              {
                "slug": "item",
                "label": "Service",
                "type": "string",
                "required": true
              }
            ]
          }
        },
        {
          "slug": "recognition",
          "label": "Awards and press",
          "type": "repeater",
          "validation": {
            "subFields": [
              {
                "slug": "item",
                "label": "Award or press mention",
                "type": "string",
                "required": true
              }
            ]
          }
        },
        {
          "slug": "email",
          "label": "Email",
          "type": "string"
        },
        {
          "slug": "social",
          "label": "Social links",
          "type": "repeater",
          "validation": {
            "subFields": [
              {
                "slug": "label",
                "label": "Name (for example Instagram)",
                "type": "string",
                "required": true
              },
              {
                "slug": "url",
                "label": "Link",
                "type": "url",
                "required": true
              }
            ]
          }
        }
      ]
    }
