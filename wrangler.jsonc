{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spatialdiscourse",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{ "binding": "DB", "database_name": "spatialdiscourse", "database_id": "db16a8ed-9891-4c75-a214-8adefbccc8de" }],
  // The cache keys on path only, so keep it off the workers.dev entrypoint (see src/worker.ts).
  "exports": { "default": { "type": "worker", "cache": { "enabled": false } }, "Site": { "type": "worker", "cache": { "enabled": true } } },
  // Scheduled publishing and maintenance.
  "triggers": { "crons": ["*/15 * * * *"] }
}
