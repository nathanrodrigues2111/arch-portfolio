---
// Change your password; admins can also add an account or reset someone's password. EmDash middleware requires sign-in.
export const prerender = false;
const me = Astro.locals.user as { role: number; email: string } | undefined;
if (!me) return Astro.redirect('/_emdash/admin/login?redirect=/_emdash/admin/passwords');
const isAdmin = me.role >= 50;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Passwords</title>
    <style>
      :root { color-scheme: light dark; --bg: #f6f6f4; --card: #fff; --text: #1a1a1a; --muted: #666; --line: #d8d8d4; --accent: #1a1a1a; --accent-text: #fff; --err: #b3261e; --ok: #1b6e2f; }
      @media (prefers-color-scheme: dark) { :root { --bg: #141414; --card: #1e1e1e; --text: #eee; --muted: #aaa; --line: #3a3a3a; --accent: #eee; --accent-text: #111; --err: #ff8a80; --ok: #7bd88f; } }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--bg); color: var(--text); font: 16px/1.5 system-ui, sans-serif; padding: 32px 16px; }
      main { max-width: 420px; margin: 0 auto; display: grid; gap: 20px; }
      a { color: inherit; }
      form { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 22px; display: grid; gap: 12px; }
      h1 { margin: 0; font-size: 22px; } h2 { margin: 0; font-size: 17px; }
      label { display: grid; gap: 6px; font-size: 14px; }
      input, select { font: inherit; padding: 9px 11px; border: 1px solid var(--line); border-radius: 6px; background: transparent; color: inherit; }
      button { font: inherit; font-weight: 600; padding: 10px; border: 0; border-radius: 6px; background: var(--accent); color: var(--accent-text); cursor: pointer; }
      .msg { margin: 0; font-size: 14px; min-height: 1.5em; } .msg.err { color: var(--err); } .msg.ok { color: var(--ok); }
    </style>
  </head>
  <body>
    <main>
      <h1>Passwords</h1>
      <p style="margin:0">Signed in as {me.email}. <a href="/_emdash/admin">Back to the editor</a></p>
      <form data-action="change">
        <h2>Change my password</h2>
        <label>Current password <input name="current" type="password" autocomplete="current-password" required /></label>
        <label>New password (10+ characters) <input name="password" type="password" autocomplete="new-password" minlength="10" required /></label>
        <p class="msg" role="status"></p>
        <button>Change password</button>
      </form>
      {isAdmin && (
        <form data-action="create">
          <h2>Add an account</h2>
          <label>Username <input name="username" autocapitalize="none" required /></label>
          <label>Email <input name="email" type="email" required /></label>
          <label>Name <input name="name" /></label>
          <label>Role <select name="role"><option value="editor">Editor</option><option value="admin">Admin</option></select></label>
          <label>Password (10+ characters) <input name="password" type="text" autocomplete="off" minlength="10" required /></label>
          <p class="msg" role="status"></p>
          <button>Add account</button>
        </form>
        <form data-action="reset">
          <h2>Reset someone's password</h2>
          <label>Username <input name="username" autocapitalize="none" required /></label>
          <label>New password (10+ characters) <input name="password" type="text" autocomplete="off" minlength="10" required /></label>
          <p class="msg" role="status"></p>
          <button>Reset password</button>
        </form>
      )}
    </main>
    <script>
      for (const form of document.querySelectorAll<HTMLFormElement>('form[data-action]')) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const msg = form.querySelector('.msg')!;
          msg.textContent = '';
          const res = await fetch('/_emdash/api/passwords', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-EmDash-Request': '1' },
            body: JSON.stringify({ action: form.dataset.action, ...Object.fromEntries(new FormData(form)) }),
          }).catch(() => null);
          const data = await res?.json().catch(() => null);
          msg.className = `msg ${res?.ok ? 'ok' : 'err'}`;
          msg.textContent = data?.message ?? data?.error ?? 'Network error. Try again.';
          if (res?.ok) form.reset();
        });
      }
    </script>
  </body>
</html>
