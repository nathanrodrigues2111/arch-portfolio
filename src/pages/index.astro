---
import { Image } from 'emdash/ui';
import { PortableText } from 'emdash/ui';
import Base from '../layouts/Base.astro';
import { getImage } from 'astro:assets';
import { getProfile, getProjects, photoUrl } from '../lib/data';

const [site, { list: projects, cacheHint }] = await Promise.all([getProfile(), getProjects()]);
// Edge cache: served from Cloudflare for an hour (stale up to a day while it refreshes); publishing purges it right away.
if (Astro.cache?.enabled) {
  Astro.cache.set(site.cacheHint);
  Astro.cache.set(cacheHint);
  Astro.cache.set({ maxAge: 3600, swr: 86400 });
}
// Lightbox gets a 1600px webp of each photo; falls back to the original if resizing is unavailable.
const big = async (img: Parameters<typeof photoUrl>[0]) => {
  const src = new URL(photoUrl(img), Astro.url.origin).href;
  try { return (await getImage({ src, width: 1600, inferSize: true, format: 'webp' })).src; } catch { return src; }
};
const tiles = await Promise.all(projects.flatMap((p) => p.photos.map(async (img, i) => ({ p, img, i, full: await big(img) }))));

// Per-project rules: hover keeps that project bright; open shows only its tiles and its info.
const css = projects.map(({ id }) => [
  `@media (hover:hover){.grid:has([data-p="${id}"]:hover) .tile:not([data-p="${id}"]){opacity:.22}}`,
  `[data-open="${id}"] .tile:not([data-p="${id}"]){display:none}`,
  `[data-open="${id}"] .pinfo[data-id="${id}"]{display:flex}`,
].join('')).join('') +
  // Flying images: each gets a staggered start and one of four 3D tilt arcs, so they move like paper.
  tiles.map((_, i) => `::view-transition-group(m${i}){animation-delay:${Math.min(i * 22, 380)}ms}::view-transition-image-pair(m${i}){animation:tilt-${'abcd'[(i * 7) % 4]} .9s cubic-bezier(.6,0,.25,1) ${Math.min(i * 22, 380)}ms both}`).join('');
---
<Base name={site.name} role={site.role} intro={site.intro}>
  <div class="loader" aria-hidden="true"><b>{site.name}</b><i></i></div>
  <style set:html={css}></style>

  <div class="split" data-open="">
    <aside class="side">
      <!-- default panel -->
      <div class="info">
        <a href="#" class="mark">{site.name}</a>
        <p>{site.role}, {site.city}<br /><span class="muted"><time data-clock data-tz={site.timezone}>--:--</time> local. {site.availability}</span></p>
        <p class="intro">{site.intro}</p>
        <div class="cols">
          <div><p>Services</p><ul class="muted">{site.services.map((x) => <li>{x}</li>)}</ul></div>
          <div><p>Recognition</p><ul class="muted">{site.recognition.map((x) => <li>{x}</li>)}</ul></div>
        </div>
        <div class="contact">
          <a class="email" href={`mailto:${site.email}`}>{site.email}</a>
          <p class="links muted">{site.social.map((s) => <a href={s.url} target="_blank" rel="noopener">{s.label}</a>)}<button class="theme" type="button" aria-label="Switch colour theme">Light</button></p>
        </div>
      </div>

      <!-- one panel per project, shown when that project is open -->
      {projects.map((d, n) => {
        const p = d;
        const next = projects[(n + 1) % projects.length];
        const meta = [['Location', d.location], ['Year', d.year], ['Type', d.type], ['Area', d.area], ['Status', d.status]].filter(([, v]) => v);
        return (
          <article class="pinfo" data-id={p.id}>
            <a href="#" class="back muted">&larr; All work</a>
            <h2>{d.title}</h2>
            <dl>{meta.map(([k, v]) => <div><dt class="muted">{k}</dt><dd>{v}</dd></div>)}</dl>
            <div class="body"><PortableText value={d.description} /></div>
            <a class="next" href={`#${next.id}`}><span class="muted">Next project</span>{next.title}</a>
          </article>
        );
      })}
    </aside>

    <main class="work">
      <section class="grid" data-view="grid">
        {tiles.map(({ p, img, i, full }, n) => (
          <a
            class="tile"
            href={`#${p.id}`}
            data-p={p.id}
            data-first={i === 0 ? "" : undefined}
            data-full={full}
          >
            <div class="cap"><b>{i === 0 ? p.title : ''}</b><span>{i === 0 ? p.year : i + 1}</span></div>
            <div class="ph">
              <Image image={img} alt={img.alt || `${p.title}, image ${i + 1}`} sizes={i === 0 ? '(max-width: 800px) 92vw, 72vw' : '(max-width: 800px) 92vw, 36vw'} priority={n < 12} />
            </div>
          </a>
        ))}
      </section>
      <div class="toggle">
        <button data-v="grid" aria-pressed="true">Grid</button>
        <button data-v="gallery" aria-pressed="false">Gallery</button>
      </div>
    </main>
  </div>

  <dialog class="lightbox" aria-label="Project gallery">
    <div class="lb-bar"><span class="lb-title"></span><span class="lb-count muted"></span><button class="lb-btn lb-close">Close</button></div>
    <div class="lb-stage" tabindex="-1" autofocus>
      <div class="lb-flow"></div>
      <button class="lb-btn lb-prev" aria-label="Previous image">&larr;</button>
      <button class="lb-btn lb-next" aria-label="Next image">&rarr;</button>
    </div>
  </dialog>
</Base>

<script>
  import Lenis from 'lenis';
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const root = document.documentElement;
  const split = document.querySelector<HTMLElement>('.split')!;
  const grid = document.querySelector<HTMLElement>('.grid')!;
  const canMorph = !reduce && !!document.startViewTransition;

  // Smooth, weighted scrolling (off for reduced motion).
  const lenis = reduce ? null : new Lenis({ autoRaf: true, lerp: 0.09 });
  // Scroll warp: images stretch and skew with scroll speed, then ease back when scrolling stops.
  if (lenis) {
    let warp = 0;
    const loop = () => {
      const target = Math.max(-1, Math.min(1, lenis.velocity / 40));
      warp += (target - warp) * 0.12;
      if (Math.abs(warp) < 0.0005) warp = 0;
      grid.style.setProperty('--warp', warp.toFixed(4));
      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);
  }
  const toTop = () => (lenis ? lenis.scrollTo(0, { immediate: true }) : window.scrollTo(0, 0));

  // Morph helper: only the given image boxes get transition names, so nothing else flies around.
  // Names are cleared once the transition ends.
  let busy = false;
  const morph = (boxes: HTMLElement[], update: () => void, cls = '') => {
    if (!canMorph || busy) return update();
    busy = true;
    boxes.forEach((b, i) => (b.style.viewTransitionName = `m${i}`));
    if (cls) root.classList.add(cls);
    const vt = document.startViewTransition(update);
    vt.finished.finally(() => {
      boxes.forEach((b) => (b.style.viewTransitionName = ''));
      if (cls) root.classList.remove(cls);
      busy = false;
    });
    return vt;
  };
  const boxesOf = (id: string) => [...grid.querySelectorAll<HTMLElement>(`.tile[data-p="${CSS.escape(id)}"] .ph`)];

  // Clock
  const clock = document.querySelector<HTMLElement>('[data-clock]')!;
  const tick = () => (clock.textContent = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: clock.dataset.tz }).format(new Date()));
  tick(); setInterval(tick, 10000);

  // Intro: name and a thin progress line on black, then panel fades in and tiles rise in a left to right wave.
  // Only on the first page view of a browser session; later views reveal straight away.
  const loader = document.querySelector<HTMLElement>('.loader')!;
  const io = new IntersectionObserver((es) => es.forEach((e) => {
    if (!e.isIntersecting) return;
    e.target.classList.remove('later');
    io.unobserve(e.target);
  }), { rootMargin: '0px 0px -8% 0px' });
  grid.addEventListener('animationend', (e) => {
    const el = e.target as HTMLElement;
    if (el.tagName === 'IMG') el.closest('.tile')?.classList.add('done');
  });
  const wave = () => {
    const g = grid.getBoundingClientRect();
    const cols = parseInt(getComputedStyle(grid).columnCount) || 2;
    const colW = g.width / cols;
    grid.querySelectorAll<HTMLElement>('.tile').forEach((t) => {
      const r = t.getBoundingClientRect();
      if (!r.height) { t.classList.add('done'); return; } // hidden (another project is open)
      if (r.top > innerHeight) {
        t.classList.add('later');
        t.style.setProperty('--y', '14vh');
        io.observe(t);
        return;
      }
      const col = Math.min(cols - 1, Math.floor((r.left - g.left + 2) / colW));
      const depth = r.top / innerHeight;
      t.style.setProperty('--d', `${Math.round(col * 120 + depth * 260)}ms`);
      t.style.setProperty('--y', `${Math.round(70 + col * 10 + depth * 20)}vh`);
    });
  };
  let started = false;
  const go = () => { if (started) return; started = true; wave(); loader.classList.add('done'); root.classList.add('in'); };
  // Never hold the page hostage: reveal after 3s even if a slow image or paused tab stalls the line.
  setTimeout(go, 3000);
  const seen = sessionStorage.getItem('intro') === '1';
  sessionStorage.setItem('intro', '1');
  if (reduce || seen) { loader.classList.add('skip'); go(); }
  else {
    const imgs = [...grid.querySelectorAll('img')].slice(0, 8);
    const start = performance.now();
    let shown = 0;
    let fontsOk = false;
    document.fonts.ready.then(() => (fontsOk = true));
    const frame = (t: number) => {
      // Follows real image and font loading; at least ~0.7s so the name registers instead of flashing.
      const ready = (imgs.filter((i) => i.complete).length + (fontsOk ? 1 : 0)) / (imgs.length + 1);
      const target = Math.min(ready, (t - start) / 700);
      shown += (target - shown) * 0.12;
      loader.style.setProperty('--p', shown.toFixed(3));
      if (shown > 0.995) { loader.style.setProperty('--p', '1'); setTimeout(go, 200); } else if (!started) requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
  }

  // Light / dark: device setting by default; the button stores an explicit choice.
  const themeBtn = document.querySelector<HTMLButtonElement>('.theme')!;
  const isDark = () => (root.dataset.theme ?? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark')) === 'dark';
  const label = () => (themeBtn.textContent = isDark() ? 'Light' : 'Dark');
  label();
  matchMedia('(prefers-color-scheme: light)').addEventListener('change', label);
  themeBtn.onclick = () => {
    const next = isDark() ? 'light' : 'dark';
    root.classList.add('theming');
    root.dataset.theme = next;
    localStorage.setItem('theme', next);
    label();
    setTimeout(() => root.classList.remove('theming'), 450);
  };

  // Grid / Gallery: fade out, relayout, fade back in. No cross-flying images.
  const btns = document.querySelectorAll<HTMLButtonElement>('.toggle button');
  const setView = (v: string) => {
    grid.dataset.view = v;
    btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.v === v)));
    localStorage.setItem('view', v);
  };
  setView(localStorage.getItem('view') === 'gallery' ? 'gallery' : 'grid');
  btns.forEach((b) => (b.onclick = () => {
    const v = b.dataset.v!;
    if (v === grid.dataset.view) return;
    // Every visible image flies to its new spot with a 3D tilt.
    morph([...grid.querySelectorAll<HTMLElement>('.ph')], () => setView(v), 'vt-swap');
  }));

  // Open a project in place. URL hash is the state, so back button and shared links work.
  const current = () => split.dataset.open || '';
  const open = (animate: boolean) => {
    const id = decodeURIComponent(location.hash.slice(1));
    const next = document.querySelector(`.pinfo[data-id="${CSS.escape(id)}"]`) ? id : '';
    const prev = current();
    if (next === prev) return;
    const apply = () => {
      (document.activeElement as HTMLElement | null)?.blur();
      split.dataset.open = next;
      toTop();
    };
    if (!animate) return apply();
    // Opening: the chosen project's images morph from grid to big. Closing: back again.
    // Project to project: plain fade. Everything else fades in after the morph lands.
    const boxes = next && !prev ? boxesOf(next) : prev && !next ? boxesOf(prev) : [];
    morph(boxes, apply, next ? 'vt-open' : 'vt-close');
  };
  open(false);
  addEventListener('hashchange', () => open(true));
  addEventListener('keydown', (e) => e.key === 'Escape' && current() && !lb.open && (location.hash = ''));

  // Lightbox: 3D coverflow of the open project's images. Native <dialog> handles Esc and focus.
  const lb = document.querySelector<HTMLDialogElement>('.lightbox')!;
  const flow = lb.querySelector<HTMLElement>('.lb-flow')!;
  let list: HTMLElement[] = [];
  let items: HTMLImageElement[] = [];
  let at = 0;
  // Coverflow position is continuous: `pos` eases toward `target` every frame, so wheel, keys and swipes all glide.
  let pos = 0, target = 0, raf = 0, idle = 0;
  const paint = () => {
    items.forEach((el, j) => {
      const o = j - pos;
      el.style.setProperty('--o', o.toFixed(4));
      el.style.setProperty('--a', Math.abs(o).toFixed(4));
    });
  };
  const tickFlow = () => {
    pos += (target - pos) * 0.14;
    if (Math.abs(target - pos) < 0.001) pos = target;
    paint();
    raf = pos === target ? 0 : requestAnimationFrame(tickFlow);
  };
  const setAt = (i: number) => {
    at = Math.max(0, Math.min(list.length - 1, i));
    items.forEach((el, j) => { el.classList.toggle('on', j === at); el.tabIndex = j === at ? -1 : 0; });
    lb.querySelector('.lb-count')!.textContent = `${at + 1} / ${list.length}`;
    lb.querySelector<HTMLButtonElement>('.lb-prev')!.disabled = at === 0;
    lb.querySelector<HTMLButtonElement>('.lb-next')!.disabled = at === list.length - 1;
  };
  const glide = (t: number) => {
    target = Math.max(0, Math.min(list.length - 1, t));
    setAt(Math.round(target));
    if (!raf) raf = requestAnimationFrame(tickFlow);
  };
  const show = (i: number) => glide(i);
  const jump = (i: number) => { setAt(i); pos = target = at; paint(); };
  // One image zooms between its tile and the front of the coverflow.
  const zoom = (fromEl: HTMLElement, toEl: () => HTMLElement, update: () => void) => {
    if (!canMorph || busy) return update();
    busy = true;
    root.classList.add('vt-lb');
    fromEl.style.viewTransitionName = 'zoom';
    let target: HTMLElement;
    const vt = document.startViewTransition(() => {
      fromEl.style.viewTransitionName = '';
      update();
      target = toEl();
      target.style.viewTransitionName = 'zoom';
    });
    vt.finished.finally(() => { if (target) target.style.viewTransitionName = ''; root.classList.remove('vt-lb'); busy = false; });
  };
  grid.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest<HTMLElement>('.tile');
    if (!t || !current()) return;
    e.preventDefault();
    if (lb.open || busy) return;
    const id = current();
    list = [...grid.querySelectorAll<HTMLElement>(`.tile[data-p="${CSS.escape(id)}"]`)];
    lb.querySelector('.lb-title')!.textContent = document.querySelector(`.pinfo[data-id="${CSS.escape(id)}"] h2`)!.textContent;
    items = list.map((x, j) => {
      const im = document.createElement('img');
      im.src = x.dataset.full!;
      im.alt = x.querySelector('img')!.alt;
      im.onclick = () => j !== at && show(j);
      im.onkeydown = (ev) => ev.key === 'Enter' && show(j);
      return im;
    });
    flow.replaceChildren(...items);
    const i = list.indexOf(t);
    items[i].decode().catch(() => {}).finally(() =>
      zoom(t.querySelector('.ph')!, () => items[at], () => { lb.showModal(); jump(i); lenis?.stop(); })
    );
  });
  const closeLb = () => {
    if (!lb.open || busy) return;
    const box = list[at].querySelector<HTMLElement>('.ph')!;
    zoom(items[at], () => box, () => { lb.close(); lenis?.start(); });
  };
  lb.addEventListener('cancel', (e) => { e.preventDefault(); closeLb(); });
  lb.querySelector('.lb-close')!.addEventListener('click', closeLb);
  lb.querySelector('.lb-stage')!.addEventListener('click', (e) => (e.target === e.currentTarget || e.target === flow) && closeLb());
  lb.querySelector('.lb-prev')!.addEventListener('click', () => show(at - 1));
  lb.querySelector('.lb-next')!.addEventListener('click', () => show(at + 1));
  lb.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(at - 1);
    if (e.key === 'ArrowRight') show(at + 1);
  });
  // Swipe and trackpad side-scroll.
  let x0 = 0;
  lb.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
  lb.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - x0;
    if (Math.abs(dx) > 50) show(at + (dx < 0 ? 1 : -1));
  });
  // Wheel and trackpad move the flow continuously, then it settles on the nearest image.
  lb.addEventListener('wheel', (e) => {
    const d = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
    glide(target + d / 420);
    clearTimeout(idle);
    idle = window.setTimeout(() => glide(Math.round(target)), 140);
  }, { passive: true });
</script>
