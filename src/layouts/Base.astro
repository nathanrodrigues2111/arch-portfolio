---
import '../styles/global.css';
import site from '../site.json';

const title = `${site.name}, ${site.role}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={site.intro} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`.replace("//", "/")} />
    <noscript><style>.side>*,.tile{animation:none!important}.loader{display:none}</style></noscript>
  </head>
  <body><slot /></body>
</html>
