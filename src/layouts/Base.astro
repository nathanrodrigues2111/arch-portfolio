---
import '../styles/global.css';

interface Props { name: string; role: string; intro: string }
const { name, role, intro } = Astro.props;
const title = [name, role].filter(Boolean).join(', ');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={intro} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <noscript><style>.side>*,.tile{animation:none!important}.loader{display:none}</style></noscript>
  </head>
  <body><slot /></body>
</html>
